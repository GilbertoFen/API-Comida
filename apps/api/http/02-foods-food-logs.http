@foodId = REEMPLAZAR_UUID_FOOD
@foodLogId = REEMPLAZAR_UUID_FOOD_LOG

### Listar alimentos
GET {{baseUrl}}/foods
Authorization: Bearer {{token}}

### Crear alimento
POST {{baseUrl}}/foods
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Greek Yogurt",
  "brand": "Demo Brand",
  "category": "Dairy",
  "servingSize": 150,
  "servingUnit": "g",
  "calories": 120,
  "proteinG": 12,
  "carbsG": 8,
  "fatG": 4,
  "fiberG": 0,
  "sugarG": 7,
  "sodiumMg": 55,
  "barcode": "1234567890123",
  "source": "manual"
}

### Buscar alimento
GET {{baseUrl}}/foods/search?query=rice
Authorization: Bearer {{token}}

### Filtrar por categoria
GET {{baseUrl}}/foods/category/Protein
Authorization: Bearer {{token}}

### Buscar por barcode
GET {{baseUrl}}/foods/barcode/1234567890123
Authorization: Bearer {{token}}

### Obtener por id
GET {{baseUrl}}/foods/{{foodId}}
Authorization: Bearer {{token}}

### Actualizar alimento
PATCH {{baseUrl}}/foods/{{foodId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Greek Yogurt Light",
  "brand": "Demo Brand",
  "category": "Dairy",
  "servingSize": 160,
  "servingUnit": "g",
  "calories": 110,
  "proteinG": 13,
  "carbsG": 7,
  "fatG": 2,
  "fiberG": 0,
  "sugarG": 6,
  "sodiumMg": 50,
  "barcode": "1234567890123",
  "source": "manual"
}

### Crear food log
POST {{baseUrl}}/food-logs
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "foodId": "{{foodId}}",
  "logDate": "2026-05-31",
  "mealType": "breakfast",
  "quantity": 1,
  "unit": "serving"
}

### Logs por fecha
GET {{baseUrl}}/food-logs?date=2026-05-31
Authorization: Bearer {{token}}

### Logs por rango
GET {{baseUrl}}/food-logs/range?startDate=2026-05-01&endDate=2026-05-31
Authorization: Bearer {{token}}

### Resumen por fecha
GET {{baseUrl}}/food-logs/summary?date=2026-05-31
Authorization: Bearer {{token}}

### Actualizar food log
PATCH {{baseUrl}}/food-logs/{{foodLogId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "foodId": "{{foodId}}",
  "logDate": "2026-05-31",
  "mealType": "snack",
  "quantity": 2,
  "unit": "servings"
}

### Eliminar food log
DELETE {{baseUrl}}/food-logs/{{foodLogId}}
Authorization: Bearer {{token}}

### Eliminar alimento
DELETE {{baseUrl}}/foods/{{foodId}}
Authorization: Bearer {{token}}


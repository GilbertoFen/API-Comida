{
  "name": "appfoodspring",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "./apps/api/mvnw -f apps/api/pom.xml spring-boot:run",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm run build --workspace web",
    "build:api": "./apps/api/mvnw -f apps/api/pom.xml package",
    "test": "npm run test:api",
    "test:api": "./apps/api/mvnw -f apps/api/pom.xml test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
